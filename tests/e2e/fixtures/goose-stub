#!/bin/sh
# Goose stub for e2e tests.
# Drop-in replacement for the goose binary inside containers AND on the host
# (host detection only needs the file to exist at ~/.local/bin/goose; the box
# launch execs it as the entrypoint).  Behavior is controlled by environment
# variables — all flags/subcommands (session, run, configure, ...) are ignored.

MODE="${GOOSE_STUB_MODE:-session}"
EXIT_CODE="${GOOSE_STUB_EXIT:-0}"
SLEEP_SECS="${GOOSE_STUB_SLEEP:-5}"
OUTPUT="${GOOSE_STUB_OUTPUT:-}"
STDERR_MSG="${GOOSE_STUB_STDERR:-}"

case "$MODE" in
    session)
        echo "goose-stub: session mode (sleep=${SLEEP_SECS}s)"
        [ -n "$OUTPUT" ] && echo "$OUTPUT"
        [ -n "$STDERR_MSG" ] && echo "$STDERR_MSG" >&2
        sleep "$SLEEP_SECS"
        exit "${EXIT_CODE}"
        ;;
    error)
        echo "goose-stub: error mode" >&2
        [ -n "$STDERR_MSG" ] && echo "$STDERR_MSG" >&2
        exit "${GOOSE_STUB_EXIT:-1}"
        ;;
    long-running)
        echo "goose-stub: long-running mode"
        [ -n "$OUTPUT" ] && echo "$OUTPUT"
        # Sleep forever — killed by container rm
        while true; do sleep 3600; done
        ;;
    *)
        echo "goose-stub: unknown mode '$MODE'" >&2
        exit 1
        ;;
esac

#!/usr/bin/env python3
"""Disposable PG manager, receiving agent, and non-acknowledging transport control."""

import hashlib
import json
import os
from pathlib import Path
import sys
import time


def closed(fd):
  try:
    os.fstat(fd)
  except OSError:
    return True
  return False


def manager():
  value = os.environ["PG_E2E_VALUE"]
  if value.encode() in Path("/proc/self/cmdline").read_bytes():
    raise SystemExit(2)
  with open(os.environ["PG_E2E_CALLS"], "a") as stream:
    stream.write(hashlib.sha256(value.encode()).hexdigest() + "\n")
  sys.stdout.write(value + "\n")


def agent():
  entry_closed = {fd: closed(fd) for fd in (3, 4)}
  from kanibako.secret_delivery import SECRET_ACK_FD, SECRET_DATA_FD

  value = os.environ.get("ANTHROPIC_AUTH_TOKEN", "")
  receipt = {
    "digest": hashlib.sha256(value.encode()).hexdigest(),
    "present": bool(value),
    "fds_closed": all(entry_closed[fd] for fd in (SECRET_DATA_FD, SECRET_ACK_FD)),
    "supervised": b"kanibako.box_supervisor" in Path("/proc/1/cmdline").read_bytes(),
  }
  workspace = Path.home() / "workspace"
  pending = workspace / "pg-receipt.pending"
  pending.write_text(json.dumps(receipt))
  pending.replace(workspace / "pg-receipt.json")
  deadline = time.monotonic() + 45
  while not (workspace / "pg-release").exists() and time.monotonic() < deadline:
    time.sleep(0.1)


def fault_host():
  from kanibako.errors import ContainerError
  from kanibako.runtime.container import ContainerRuntime
  from kanibako.secret_delivery import SecretPayload, SecretValue
  from kanibako.settings.config_io import fetch_persona_secret

  # The receiver drains and closes both transport FDs, but deliberately sends no ACK.
  receiver = "\n".join(
    [
      "import fcntl, json, os, signal, threading, time",
      "from kanibako.secret_delivery import SECRET_DATA_FD, SECRET_ACK_FD, read_payload",
      "released = threading.Event()",
      "signal.signal(signal.SIGUSR1, lambda *_: released.set())",
      "with os.fdopen(SECRET_DATA_FD, 'rb') as stream: read_payload(stream)",
      "hold = fcntl.fcntl(SECRET_ACK_FD, fcntl.F_DUPFD_CLOEXEC, max(SECRET_DATA_FD, SECRET_ACK_FD) + 1)",
      "os.close(SECRET_ACK_FD)",
      "closed = []",
      "for fd in (SECRET_DATA_FD, SECRET_ACK_FD):",
      "  try: os.fstat(fd)",
      "  except OSError: closed.append(fd)",
      "print(json.dumps({'fault_drained': True, 'receiver_fds_closed': len(closed) == 2}), flush=True)",
      "released.wait(40)",
      "os.close(hold)",
      "time.sleep(30)",
    ]
  )
  value = fetch_persona_secret("pipeproof", root=Path(sys.argv[2]))
  before = set(os.listdir("/proc/self/fd"))
  started = time.monotonic()
  failed = False
  try:
    ContainerRuntime().run(
      sys.argv[3],
      shell_path=Path(sys.argv[4]),
      project_path=Path(sys.argv[5]),
      vault_ro_path=None,
      vault_rw_path=None,
      enable_vault=False,
      name=sys.argv[6],
      entrypoint="python3",
      cli_args=["-c", receiver],
      secret_payload=SecretPayload((SecretValue("ANTHROPIC_AUTH_TOKEN", value.encode()),)),
      publication_timeout=30,
    )
  except ContainerError:
    failed = True
  print(
    json.dumps(
      {
        "publication_failed": failed,
        "host_fds_closed": set(os.listdir("/proc/self/fd")) == before,
        "elapsed": time.monotonic() - started,
      }
    ),
    flush=True,
  )
  return 0 if failed else 1


if __name__ == "__main__":
  if sys.argv[1:2] == ["--manager"]:
    manager()
  elif sys.argv[1:2] == ["--fault-host"]:
    raise SystemExit(fault_host())
  else:
    agent()
